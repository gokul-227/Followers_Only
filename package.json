{
  "name": "followersonly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:local": "node scripts/local-db.mjs",
    "db:stop": "node scripts/local-db.mjs stop",
    "env:init": "node scripts/init-env.mjs",
    "format": "prettier --write src tests scripts *.ts *.mjs *.json",
    "format:check": "prettier --check src tests scripts *.ts *.mjs *.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1172.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "file-type": "21.3.4",
    "lucide-react": "0.468.0",
    "next": "16.4.6",
    "nodemailer": "10.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "sharp": "0.35.5",
    "tailwindcss": "4.1.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "type": "module"
}
